{
  "name": "grpc-learning",
  "version": "1.0.0",
  "description": "A comprehensive gRPC learning course in Node.js and pure JavaScript",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node lessons/01-grpc-fundamentals/server.js",
    "test": "jest --runInBand --forceExit",
    "test:integration": "jest tests/18-microservices.test.js --runInBand --forceExit",
    "lint": "eslint \"src/**/*.js\" \"lessons/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proto:check": "node scripts/check-protos.js",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "lesson:01:server": "node lessons/01-grpc-fundamentals/server.js",
    "lesson:01:client": "node lessons/01-grpc-fundamentals/client.js",
    "lesson:02:server": "node lessons/02-protocol-buffers/server.js",
    "lesson:02:client": "node lessons/02-protocol-buffers/client.js",
    "lesson:03:server": "node lessons/03-unary-rpc/server.js",
    "lesson:03:client": "node lessons/03-unary-rpc/client.js",
    "lesson:04:server": "node lessons/04-server-streaming/server.js",
    "lesson:04:client": "node lessons/04-server-streaming/client.js",
    "lesson:05:server": "node lessons/05-client-streaming/server.js",
    "lesson:05:client": "node lessons/05-client-streaming/client.js",
    "lesson:06:server": "node lessons/06-bidirectional-streaming/server.js",
    "lesson:06:client": "node lessons/06-bidirectional-streaming/client.js",
    "lesson:07:server": "node lessons/07-deadlines-and-timeouts/server.js",
    "lesson:07:client": "node lessons/07-deadlines-and-timeouts/client.js",
    "lesson:08:server": "node lessons/08-error-handling/server.js",
    "lesson:08:client": "node lessons/08-error-handling/client.js",
    "lesson:09:server": "node lessons/09-metadata-and-interceptors/server.js",
    "lesson:09:client": "node lessons/09-metadata-and-interceptors/client.js",
    "lesson:10:server": "node lessons/10-authentication-and-authorization/server.js",
    "lesson:10:client": "node lessons/10-authentication-and-authorization/client.js",
    "lesson:11:server": "node lessons/11-tls-and-security/server.js",
    "lesson:11:client": "node lessons/11-tls-and-security/client.js",
    "lesson:12:server": "node lessons/12-cancellation-and-retries/server.js",
    "lesson:12:client": "node lessons/12-cancellation-and-retries/client.js",
    "lesson:13:server": "node lessons/13-health-checking/server.js",
    "lesson:13:client": "node lessons/13-health-checking/client.js",
    "lesson:14:demo": "node lessons/14-reflection-and-debugging/demo.js",
    "lesson:15:demo": "node lessons/15-load-balancing/demo.js",
    "lesson:16:compare": "node lessons/16-rest-vs-grpc/benchmark.js",
    "lesson:17:demo": "node lessons/17-database-integration/demo.js",
    "microservices:start": "node lessons/18-microservices/start-all.js",
    "microservices:client": "node lessons/18-microservices/demo-client.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "selfsigned": "^5.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  },
  "license": "MIT",
  "author": "Ankit Mohanty"
}
